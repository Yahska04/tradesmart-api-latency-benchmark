# TradeSmart Latency Benchmark: server configuration template.
#
# Installed as /etc/tsbench/tsbench.env (root:tsbench, 0640) and loaded by systemd (EnvironmentFile).
# install.sh creates it once and never overwrites it. Apply changes with: sudo systemctl restart tsbench
#
# Syntax: KEY=value on one line, no spaces around "=". Never commit the real file.
# Blank secrets are treated as "missing": `python -m src.doctor` fails and the service is not started.

# --- Deployment ------------------------------------------------------------------------------------------
# server = login required, roles enforced, one shared access token.
TS_DEPLOYMENT=server
# live = the real TradeSmart account. Other values: uat, mock.
TS_ENVIRONMENT=live

# --- TradeSmart API app (secrets) ------------------------------------------------------------------------
# Issued by TradeSmart for your API app. Example shape only: TS_APP_KEY=your-app-key-here
TS_APP_KEY=
TS_SECRET_KEY=
TS_CLIENT_ID=
# Must match the redirect URL registered with TradeSmart exactly. Both of these reach the Settings page:
#   https://your-server.example.com/callback
#   http://your-server.example.com/callback
TS_REDIRECT_URL=

# --- Login proxy -----------------------------------------------------------------------------------------
# Shared secret proving a request came through Nginx. Generated by install.sh, which also copies it into
# /etc/nginx/tsbench-proxy-secret.conf. If you change it here, run install.sh again to update Nginx.
TS_AUTH_PROXY_SECRET=
# Comma-separated Nginx login names (see deploy/manage-user.sh). Example: TS_ADMIN_USERS=alice,bob
# Admins can open Settings and generate the access token.
TS_ADMIN_USERS=
# Comma-separated login names allowed to run the live order latency test. Example: TS_ORDER_USERS=alice
TS_ORDER_USERS=

# --- Static IP -------------------------------------------------------------------------------------------
# Leave blank: an admin sets the static IP registered with TradeSmart in the app's Settings page later.
TS_STATIC_IP=
# 1 = refuse orders when the static IP is not set, can't be detected, or differs from the server's outbound IP.
# Read-only requests are not blocked; they only show a warning.
TS_ENFORCE_STATIC_IP=1
# Optional: local address for outgoing traffic, on servers with several network interfaces. Example: 10.0.0.5
TS_OUTBOUND_BIND_IP=
# Service that reports this server's public IP as plain text.
TS_IP_CHECK_URL=https://api.ipify.org

# --- Storage (fixed server layout: do not change) ----------------------------------------------------------
TS_DB_PATH=/var/lib/tsbench/benchmark.db
TS_LOG_PATH=/var/log/tsbench/app.log
TS_TOKEN_FILE=/var/lib/tsbench/.access_token
