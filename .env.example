# Copy this file to .env and fill in your own values. NEVER commit .env.
# All values below are placeholders.
#
# On a company server, do not use a .env file: the service reads /etc/tsbench/tsbench.env
# (template: deploy/tsbench.env.example). See docs/DEPLOYMENT.md.

# --- Endpoints (official defaults from https://apidocs.tradesmartonline.in/v2/) ---
TS_BASE_URL=https://v2api.tradesmartonline.in/NorenWClientAPIv2
TS_WS_URL=wss://v2api.tradesmartonline.in/NorenWSAPI/
TS_OAUTH_URL=https://v2api.tradesmartonline.in/OAuthlogin/authorize/oauth

# --- Credentials issued by TradeSmart for your API app (secrets) ---
TS_APP_KEY=your-app-key-here
TS_SECRET_KEY=your-secret-key-here
TS_CLIENT_ID=your-client-id-here
TS_REDIRECT_URL=https://your-registered-redirect-url/callback

# Optional: paste a valid access token here instead of using the in-app OAuth helper.
# In server mode a token generated in Settings (saved in TS_TOKEN_FILE) takes priority over this value.
TS_ACCESS_TOKEN=

# --- Environment: live | uat | mock ---
# "live" = real TradeSmart account. Benchmarks and checks never send order or other state-changing requests.
# The opt-in Order latency test page is the only exception.
TS_ENVIRONMENT=live

# --- Deployment: local | server ---
# local  = one person on their own PC. No login, every feature available, token kept in the browser session.
# server = shared server behind Nginx. Login required, roles enforced, one shared token saved in TS_TOKEN_FILE,
#          orders blocked unless the static IP check passes. Any other value is treated as server.
TS_DEPLOYMENT=local

# --- Server mode only (ignored when TS_DEPLOYMENT=local) ---
# Shared secret Nginx sends in X-Proxy-Secret. It must match /etc/nginx/tsbench-proxy-secret.conf.
# If it is empty or does not match, everyone is denied access.
TS_AUTH_PROXY_SECRET=
# Comma-separated login names. Admins can open Settings. Order users can open the Order latency test page.
TS_ADMIN_USERS=
TS_ORDER_USERS=

# --- Static IP ---
# The public IP registered with TradeSmart. An admin can also enter it in Settings -> Server IP, and that value
# overrides this one. Local mode: recorded for information only.
TS_STATIC_IP=
# 1 = refuse orders unless the static IP is set, can be detected and matches. 0 = warn only.
# Leave empty for the default: on in server mode, off in local mode.
TS_ENFORCE_STATIC_IP=
# Only for a server with several network interfaces: the LOCAL address to send API traffic from.
# It must be an address assigned to this machine. Leave empty when one route out or a NAT rule is used.
TS_OUTBOUND_BIND_IP=
# IP-echo service used to detect this machine's public IP. It must return the address as plain text.
TS_IP_CHECK_URL=https://api.ipify.org

# --- Local storage ---
TS_DB_PATH=data/benchmark.db
TS_LOG_PATH=data/logs/app.log
# Shared token file (server mode). Leave empty for .access_token in the same folder as TS_DB_PATH.
TS_TOKEN_FILE=

# Set to 0 to skip the script master download at start-up (offline use).
TS_SCRIPT_MASTER_AUTOSTART=1
